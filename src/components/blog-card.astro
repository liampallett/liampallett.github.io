---
const { title, link, description, date } = Astro.props as {
    title: string,
    link: string,
    description: string,
    date: Date;
};
---

<div class="card">
    <div class="top-bar">
        <h2 class="card-title">{title}</h2>
        <a href={link} target="_blank" class="view-link">View Post</a>
    </div>
    <p class="description-text">{description}</p>
    <p class="date-text">{date.toLocaleDateString()}</p>
</div>

<style>
    .card {
        padding: 1em;
        margin-bottom: 5em;
        text-align: left;
    }

    .top-bar {
        display: flex;
        align-items: flex-start;
    }

    .top-bar .card-title {
        font-size: 2.5em;
        margin-top: 0;
        margin-bottom: 0;
    }

    .top-bar a {
        font-size: 2.5em;
        margin-left: auto;
    }

    .card .description-text {
        margin: 0;
        font-size: 1.9em;
    }

    .view-link {
        color: var(--black-kite);
        text-decoration: none;
        transition: color 0.1s ease-in-out;
    }

    .view-link:hover {
        color: var(--garnet);
        text-decoration: underline;
    }

    .date-text {
        margin: 0;
        font-size: 1.4em;
        color: var(--garnet);
    }

    @media screen and (max-width: 800px) {
        .top-bar {
            flex-direction: column;
        }

        .top-bar a {
            margin-left: 0;
            margin-top: 0.5em;
        }
    }
</style>