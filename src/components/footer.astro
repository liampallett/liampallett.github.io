---

<footer>
    <p>Email: <a href="mailto:liam.pallett06@gmail.com" class="email">liam.pallett06@gmail.com</a></p>

    <div class="footer-meta">
        <p>© Liam Pallett 2026</p>
        <p>Made with <i class="fa-solid fa-heart"></i> (and <a href="https://astro.build/" target="_blank">Astro</a>).</p>
    </div>
</footer>

<style>
    footer {
        display: flex;
        flex-direction: column;
        padding: 2em;
        background-color: var(--black-kite);
        color: var(--morning-snow);
        font-size: 2em;
    }

    a {
        color: var(--morning-snow);
		text-decoration: none;
		transition: color 0.1s ease-in-out;
	}

    p {
        margin-bottom: 0;
    }

	a:hover {
		color: var(--garnet);
		text-decoration: underline;
	}

    .footer-meta {
        display: flex;
        justify-content: space-between;
    }

    .email {
        cursor: pointer;
        word-break: break-all;
    }

    @media screen and (max-width: 800px) {
        .footer-meta {
            flex-direction: column;
            gap: 0.5em;
        }
    }
</style>

<script is:inline>
	const emailText = document.querySelector(".email");
    document.querySelector(".email").addEventListener("click", copyEmail)

	function copyEmail() {
		emailText.textContent = "Copied!";
		navigator.clipboard.writeText("liam.pallett06@gmail.com");

		setTimeout(resetEmail, 5000);
	}

	function resetEmail() {
		emailText.textContent = "liam.pallett06@gmail.com"
	}
</script>