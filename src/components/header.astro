---

---

<header>
    <p><i class="fa-solid fa-user-astronaut"></i></p>
    <a href="/" class={Astro.url.pathname === "/" ? "active" : ""} aria-current={Astro.url.pathname === "/" ? "page" : undefined}>Home</a>
    <a href="/projects" class={Astro.url.pathname === "/projects" ? "active" : ""} aria-current={Astro.url.pathname === "/projects" ? "page" : undefined}>Projects</a>
    <a href="/blog" class={Astro.url.pathname === "/blog" ? "active" : ""} aria-current={Astro.url.pathname === "/blog" ? "page" : undefined}>Blog</a>

    <div class="socials">
        <a href="https://bsky.app/profile/liam-pallett.bsky.social" target="_blank" rel="noopener noreferrer" aria-label="Bluesky"><i class="fa-brands fa-bluesky"></i></a>
        <a href="https://github.com/liampallett" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><i class="fa-brands fa-github"></i></a>
        <a href="https://www.linkedin.com/in/liam-pallett/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
        <a href="https://www.reddit.com/user/liam_pallett/" target="_blank" rel="noopener noreferrer" aria-label="Reddit"><i class="fa-brands fa-reddit-alien"></i></a>
    </div>
</header>

<style>
    header {
        background-color: var(--black-kite);
        display: flex;
        gap: 1.5em;
        padding: 2em;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 100;
        box-sizing: border-box;
    }

    p {
        color: var(--morning-snow);
        font-size: 2.5em;
        margin: 0;
    }

    .socials {
        margin-left: auto;
        display: flex;
        gap: 1.5em;
    }

    @media screen and (max-width: 800px) {
        header {
            font-size: 0.75em;
            justify-content: center;
        }

        .socials {
            display: none;
        }
    
        p {
            display: none;
        }
    }

    a {
        font-size: 2.5em;
        color: var(--morning-snow);
        transition: color 0.1s ease-in-out;

        text-decoration: none;
    }

    a.active {
        color: var(--garnet);
    }

    a:hover {
        color: var(--garnet);
        text-decoration: underline;
    }
</style>

<style is:global>
    :root {
        --header-height: 213px;
    }

    @media screen and (max-width: 800px) {
        :root {
            --header-height: 163px;
        }
    }
</style>