---
import Layout from "../layouts/layout.astro";
import Vh from "../components/vh.astro";
import ProjectCard from "../components/project-card.astro";
---

<Layout title="Liam Pallett">
	<Vh>
		<div class="hero-content">
			<h1 class="name">Hi! I'm Liam Pallett.</h1>
			<p class="blurb">I'm a 19 year old aspiring aerospace software engineer. A CS student at the University of Sheffield, I'm building my C++ skills via competitive programming.</p>
			<a href="/Liam%20Pallett%20CV.pdf" class="link" target="_blank">Download CV</a>

			<div class="socials">
				<a href="https://bsky.app/profile/liam-pallett.bsky.social" target="_blank"><i class="fa-brands fa-bluesky"></i></a>
				<a href="https://github.com/liampallett" target="_blank"><i class="fa-brands fa-github"></i></a>
				<a href="https://www.linkedin.com/in/liam-pallett/" target="_blank"><i class="fa-brands fa-linkedin-in"></i></a>
				<a href="https://www.reddit.com/user/liam_pallett/" target="_blank"><i class="fa-brands fa-reddit-alien"></i></a>
			</div>

			<ProjectCard title="Featured: Flight Dynamics (2026)" link="https://github.com/liampallett/flight-dynamics"
						 description="Flight dynamics simulator written in Python. Simulate complex multi-stage rockets with different propellant and engine configuration."
						 tags={["Python", "Isentropic Flow", "Simulation", "Rocketry"]}>
			</ProjectCard>

			<a class="link" href="/projects" >See all projects</a>
		</div>
	</Vh>
</Layout>

<style>
	.hero-content {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0 1em;
		margin-bottom: 5rem;
	}

    .hero-content :global(.card) {
        margin-bottom: 1em;
    }

	.name {
		font-size: 5em;
		margin: 0;
	}

	.blurb {
		font-size: 2.5em;
		margin: 0;
	}

	.link {
		color: var(--black-kite);
		text-decoration: none;
		font-size: 2.5em;
		transition: color 0.1s ease-in-out;
	}

	.link:hover {
		color: var(--garnet);
		text-decoration: underline;
	}

	.socials {
        display: none;
        gap: 1em;
    }

	.socials a {
		color: var(--black-kite);
		font-size: 2.5em;
	}

	.socials a:hover {
        color: var(--garnet);
        text-decoration: underline;
    }

	@media screen and (max-width: 800px) {
		.socials {
			font-size: 0.75em;
			display: flex;
			justify-content: center;
		}

		.name {
			font-size: 3.5em;
		}

		.blurb {
			font-size: 1.5em;
		}

		.link {
			font-size: 1.5em;
		}
	}
</style>